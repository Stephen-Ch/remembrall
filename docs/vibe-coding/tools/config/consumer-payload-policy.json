{
  "policyName": "consumer-payload-boundary",
  "version": "2026-05-04.001",
  "strategy": "hybrid-allowlist-first-with-denylist-guardrails",
  "description": "Allowlist defines consumer-facing payload contract. Denylist is enforced after allowlist and any match fails audit.",
  "allowlistPatterns": [
    "README.md",
    "QUICKSTART.md",
    "MIGRATION-INSTRUCTIONS.md",
    "VIBE-CODING.VERSION.md",
    "FILE-VERSIONING.md",
    "protocol-lite.md",
    "session-start-checklist.md",
    "protocol/**",
    "standards/**",
    "templates/**",
    "tools/**",
    "terminology/**",
    "portability/**",
    "docs/forGPT/**"
  ],
  "denylistPatterns": [
    "docs/status/REPORT-KIT-*.md",
    "docs/status/POSTMORTEM-CONSUMER-*.md",
    "docs/status/ROADMAP-KIT-*.md",
    "docs/research/**",
    "docs/research/ResearchIndex.md",
    "kit-workspace/**",
    ".github/**",
    ".vscode/**",
    "tools/tests/**",
    "tools/audit-consumer-payload.ps1",
    "tools/check-prior-research.ps1",
    "tools/check-protocol-v7-budget.ps1",
    "tools/publish-consumer-payload.ps1",
    "tools/session-start-kit.ps1",
    "tools/verify-protocol-index.ps1",
    "tools/vibe-kit-snapshot.ps1",
    "run-consumer-regression-tests.ps1",
    "protocol/consumer-session-postmortem-temporary.md",
    "templates/consumer-session-postmortem-template.md",
    "REPORT-KIT-*.md",
    "POSTMORTEM-CONSUMER-*.md",
    "docs/forGPT/VIBE-KIT-SNAPSHOT.md",
    "**/VIBE-KIT-SNAPSHOT.md"
  ]
}