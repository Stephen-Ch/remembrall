# Copy to .env.test.local and fill in values before running Playwright tests.
# Never commit .env.test.local

PLAYWRIGHT_TEST_MODE=true
DATABASE_URL=postgresql://remembrall_app:<password>@<host>.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:<password>@<host>.supabase.co:5432/postgres
AUTH_SECRET=<any-random-string-for-test>
