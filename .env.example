# Remembrall — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file with real credentials.

# Supabase connection (non-owner app role — RLS enforced)
DATABASE_URL="postgresql://remembrall_app:password@host.supabase.co:5432/postgres"

# Supabase direct connection (postgres superuser — migrations only)
DIRECT_URL="postgresql://postgres:password@host.supabase.co:5432/postgres"

# Auth.js
AUTH_SECRET="replace-with-output-of-npx-auth-secret"
AUTH_TRUST_HOST=true

# Email provider (Resend or similar — for magic link)
AUTH_RESEND_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="no-reply@remembralls.net"
